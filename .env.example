# Supabase: Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key. Used by the scheduled scan, the digest and account
# deletion. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the deployed app (used in digest emails and links)
NEXT_PUBLIC_APP_URL=https://rolesearchhq.vercel.app
# Shown on the Privacy and Terms pages so people can reach you
NEXT_PUBLIC_CONTACT_EMAIL=

# Groq: console.groq.com/keys (free, no card). One key shared by all users;
# per-user daily limits in lib/limits.ts keep it from being drained.
GROQ_API_KEY=

# Adzuna: developer.adzuna.com/signup (free, no card, ~1000 calls/month)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Resend: resend.com. To email people other than yourself you must verify a
# sending domain and set RESEND_FROM to an address on it.
RESEND_API_KEY=
RESEND_FROM=RoleSearchHQ <digest@your-verified-domain.com>

# REQUIRED. At least 16 random characters. /api/cron/scan and /api/digest
# refuse to run without it. Generate one with: openssl rand -hex 24
CRON_SECRET=
